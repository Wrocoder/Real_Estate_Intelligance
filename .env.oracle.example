# Copy this file to /srv/domarion/env/oracle.env on the OCI VM.
# Keep the copied file outside git and replace every change-me/example value.

COMPOSE_PROJECT_NAME=domarion
DOMARION_DATA_DIR=/srv/domarion

# First bootstrap can build local images on the VM. For registry deploys, replace
# these with GHCR tags and run scripts/deploy_oracle_cloud.sh --pull-images.
API_IMAGE=domarion-api:oracle
FRONTEND_IMAGE=domarion-frontend:oracle
POSTGIS_IMAGE=domarion-postgis:16-3

# Public DNS names. Both must resolve to the VM public IP before Caddy can issue TLS certs.
DOMARION_FRONTEND_DOMAIN=app.example.com
DOMARION_API_DOMAIN=api.example.com

APP_NAME=WartoMetr API
# Use staging for the first OCI smoke deploy. Switch to production only after the release gate passes.
ENVIRONMENT=staging
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

POSTGRES_DB=domarion
POSTGRES_USER=domarion
POSTGRES_PASSWORD=change-me
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=6GB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_WORK_MEM=16MB
DATABASE_URL=postgresql+psycopg://domarion:change-me@db:5432/domarion

REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["https://app.example.com"]

NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_SITE_URL=https://app.example.com
NEXT_PUBLIC_OWNER_ID=demo-user
NEXT_TELEMETRY_DISABLED=1

DATA_REPOSITORY_BACKEND=postgres
REPORT_STORE_BACKEND=postgres
REPORT_ORDER_STORE_BACKEND=postgres
USER_STORE_BACKEND=postgres
AUTH_STORE_BACKEND=postgres
AGENCY_STORE_BACKEND=postgres
CRM_STORE_BACKEND=postgres
INGESTION_ADMIN_STORE_BACKEND=postgres
USER_SUBMITTED_LISTING_STORE_BACKEND=postgres
PARTNER_REFERRAL_STORE_BACKEND=postgres
AI_INSIGHT_STORE_BACKEND=postgres
NEWS_STORE_BACKEND=postgres
CUSTOM_DASHBOARD_STORE_BACKEND=postgres

# OCI staging can use local artifacts on the VM data volume.
# Paid production should use s3 with OCI Object Storage or Cloudflare R2.
REPORT_ARTIFACT_STORAGE_BACKEND=local
REPORT_ARTIFACT_LOCAL_DIR=/srv/domarion/artifacts/reports
REPORT_ARTIFACT_PUBLIC_BASE_URL=
REPORT_ARTIFACT_S3_ENDPOINT_URL=
REPORT_ARTIFACT_S3_REGION=eu-frankfurt-1
REPORT_ARTIFACT_S3_BUCKET=
REPORT_ARTIFACT_S3_PREFIX=production/reports
REPORT_ARTIFACT_S3_ACCESS_KEY_ID=
REPORT_ARTIFACT_S3_SECRET_ACCESS_KEY=

PAYMENT_PROVIDER=mock
PAYMENT_CHECKOUT_BASE_URL=
PAYMENT_SUCCESS_URL=https://app.example.com/reports
PAYMENT_CANCEL_URL=https://app.example.com/pricing
PAYMENT_CHECKOUT_TIMEOUT_SECONDS=10
STRIPE_SECRET_KEY=
STRIPE_API_BASE_URL=https://api.stripe.com
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_WEBHOOK_SECRET=
PAYU_API_BASE_URL=https://secure.snd.payu.com
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_MERCHANT_POS_ID=
PAYU_NOTIFY_URL=https://api.example.com/api/v1/payment-webhooks/payu
PAYU_CUSTOMER_IP=127.0.0.1
PAYU_SECOND_KEY=

ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SENDER=alerts@example.com
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_USE_TLS=true
ALERT_DELIVERY_TIMEOUT_SECONDS=10
ALERT_TELEGRAM_ENABLED=false
ALERT_TELEGRAM_BOT_NAME=WartoMetrBot
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_API_BASE_URL=https://api.telegram.org

WORKER_TASKS=daily-email-alerts,area-market-snapshots,price-history-rebuild
WORKER_INTERVAL_SECONDS=3600
WORKER_RUN_ONCE=false
WORKER_APPLY=false
WORKER_FORCE=false
ALERT_WORKER_SEND=false
ALERT_WORKER_MAX_MATCHES=10
ALERT_WORKER_LIMIT=500

BACKUP_OUTPUT_DIR=/srv/domarion/backups/postgres
BACKUP_PREFIX=domarion-postgres
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_HOURS=30
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=production/postgres
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=eu-frankfurt-1
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore

UPTIME_MONITOR_URL=
JOB_FAILURE_ALERT_TARGET=
SOURCE_FRESHNESS_ALERT_TARGET=
PAYMENT_WEBHOOK_ALERT_TARGET=
COST_ALERTS_CONFIGURED=false

API_LITE_KEYS_JSON=
API_LITE_DEFAULT_MONTHLY_QUOTA=1000
API_LITE_DEFAULT_RATE_LIMIT_PER_MINUTE=60
SCORING_WEIGHTS_JSON=
DEMO_USER_ID=demo-user
DEMO_USER_EMAIL=demo@example.com
