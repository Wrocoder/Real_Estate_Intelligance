[Unit]
Description=WartoMetr PostgreSQL logical backup
Requires=docker.service
After=docker.service network-online.target domarion-compose.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/domarion/app
ExecStart=/bin/sh -lc '/usr/bin/docker compose --env-file /srv/domarion/env/oracle.env -f compose.oracle.yaml run --rm --no-deps --user "$(id -u domarion):$(id -g domarion)" api python scripts/postgres_backup.py backup'
